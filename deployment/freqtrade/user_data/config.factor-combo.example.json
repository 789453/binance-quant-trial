{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "dry_run": true,
  "initial_state": "stopped",
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "max_open_trades": 12,
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.95,
  "fiat_display_currency": "USD",
  "strategy": "FactorComboTargetStrategy",
  "dataformat_ohlcv": "parquet",
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "pair_whitelist": [
      "ADA/USDT:USDT", "AVAX/USDT:USDT", "BCH/USDT:USDT", "BNB/USDT:USDT",
      "BTC/USDT:USDT", "DOGE/USDT:USDT", "ETH/USDT:USDT", "LINK/USDT:USDT",
      "LTC/USDT:USDT", "SOL/USDT:USDT", "TRX/USDT:USDT", "XRP/USDT:USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [{"method": "StaticPairList"}],
  "entry_pricing": {"price_side": "same", "use_order_book": true, "order_book_top": 1},
  "exit_pricing": {"price_side": "same", "use_order_book": true, "order_book_top": 1},
  "api_server": {"enabled": false},
  "bot_name": "factor-combo-shadow",
  "db_url": "sqlite:///tradesv3.factor-combo-dryrun.sqlite"
}


